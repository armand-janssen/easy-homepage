# ===========================================
# Easy Homepage - Environment Configuration
# ===========================================

# Server Configuration
PORT=3000
HOST=localhost
NODE_ENV=development

# Application Settings
APP_TITLE=My Personal Links
CACHE_DURATION_HOURS=2

# Data Source Configuration
# Option 1: Use local JSON file (recommended for development)
LOCAL_JSON_PATH=./data/private.json

# Option 2: Use GitHub repository (uncomment and configure if needed)
# GITHUB_URL=https://api.github.com/repos/yourusername/yourrepo/contents/data.json
# GITHUB_TOKEN=ghp_your_github_token_here

# Logo Service Configuration
# Get your token from https://logo.dev/
# LOGO_DEV_TOKEN=your_logo_dev_token_here

# ===========================================
# Development vs Production Notes
# ===========================================
# 
# For local development:
# - Use LOCAL_JSON_PATH pointing to your data file
# - Set NODE_ENV=development for detailed logging
# - Set HOST=localhost for local access
#
# For production:
# - Consider using GITHUB_URL for centralized data management
# - Set NODE_ENV=production for optimized logging
# - Set HOST=0.0.0.0 for Docker/container deployment
# - Add LOGO_DEV_TOKEN for better logo fetching
#
# ===========================================