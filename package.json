{
  "name": "easy-homepage",
  "version": "1.0.0",
  "description": "A modern, responsive homepage application for displaying personal links",
  "main": "src/app.js",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -o public/css/tailwind.css --minify",
    "dev": "pnpm build:css && node --watch src/app.js",
    "start": "node src/app.js",
    "test": "node --test"
  },
  "keywords": [
    "homepage",
    "links",
    "dashboard",
    "fastify",
    "tailwind"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/static": "^10.1.12",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.8",
    "pino-pretty": "^13.2.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "tailwindcss": "3"
  }
}
