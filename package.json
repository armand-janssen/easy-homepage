{
  "name": "easy-homepage",
  "version": "1.0.0",
  "description": "A modern, responsive homepage application for displaying personal links",
  "main": "src/app.js",
  "scripts": {
    "dev": "nodemon src/app.js",
    "start": "node src/app.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "nodemonConfig": {
    "ignore": [
      "tmp-sites.json",
      "logos/*",
      "node_modules/*",
      ".git/*"
    ],
    "ext": "js,json"
  },
  "keywords": [
    "homepage",
    "links",
    "dashboard",
    "fastify",
    "tailwind"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^8.3.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "pino-pretty": "^13.1.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
